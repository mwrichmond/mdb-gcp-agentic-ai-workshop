import json
from google.adk.tools import ToolContext, FunctionTool

def inspect_live_session(tool_context: ToolContext) -> str:
    """A tool that pulls the official ADK Session properties and formats them cleanly for the UI."""
    # 1. Safely extract properties directly from the framework's runtime context
    user_id = getattr(tool_context, 'user_id', 'Not Set')
    session_id = getattr(tool_context, 'session_id', 'Not Set')
    app_name = getattr(tool_context, 'app_name', 'Not Set')
    last_update = getattr(tool_context, 'last_update_time', 'Not Set')

    # 2. Extract state keys safely into a regular Python dictionary
    state_display = {}
    current_state = tool_context.state
    if current_state:
        try:
            for key, value in current_state.items():
                state_display[str(key)] = value
        except Exception:
            state_display = {"status": "Unable to read keys"}

    # 3. Pull history events count to keep the JSON clean instead of dumping raw objects
    events_count = 0
    if hasattr(tool_context, 'events') and tool_context.events:
        try:
            events_count = len(tool_context.events)
        except Exception:
            events_count = "Available"

    # 4. Map directly to your exact requested JSON structure
    session_schema = {
        "id": session_id,
        "appName": app_name,
        "userId": user_id,
        "events": f"[{events_count} history objects recorded]",
        "state": state_display if state_display else {},
        "lastUpdateTime": str(last_update)
    }

    # 5. Output cleanly formatted JSON inside standard Markdown code blocks
    formatted_json = json.dumps(session_schema, indent=2, default=str)
    return f"```json\n{formatted_json}\n```"

# Correct initialization syntax for Google ADK FunctionTool
inspect_session_tool = FunctionTool(inspect_live_session)
